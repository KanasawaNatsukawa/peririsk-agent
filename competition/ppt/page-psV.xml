          <ns0:p textAlign="center" lineSpacing="multiple:1.2" marginRight="0" defaultTabSize="72"><ns0:span color="rgba(29, 29, 26, 1)" fontSize="18" fontFamily="Microsoft YaHei" bold="false" italic="false" strikethrough="false" underline="false">技术依赖（可选）</ns0:span></ns0:p>
