      <ns0:shape width="425.6569291338583" height="125" topLeftX="480.0006299212598" topLeftY="372.38992125984254" presetHandlers="0" type="round-rect" id="bHI">
        <ns0:content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left">
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">进展：Demo 已跑通，命令行 + Streamlit，GitHub 可复现；5 例批量测试：ASA 分级一致率 </ns0:span></ns0:em><ns0:strong><ns0:em><ns0:span color="rgba(192, 0, 0, 1)" fontSize="15" fontFamily="DengXian" strikethrough="false" underline="false">100%</ns0:span></ns0:em></ns0:strong><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">、工具调用顺序正确率 </ns0:span></ns0:em><ns0:strong><ns0:em><ns0:span color="rgba(192, 0, 0, 1)" fontSize="15" fontFamily="DengXian" strikethrough="false" underline="false">100%</ns0:span></ns0:em></ns0:strong><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">，心率算法误差 </ns0:span></ns0:em><ns0:strong><ns0:em><ns0:span color="rgba(192, 0, 0, 1)" fontSize="15" fontFamily="DengXian" strikethrough="false" underline="false">5.7 次/分</ns0:span></ns0:em></ns0:strong><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">（88.0 vs 监护仪 82.3）；</ns0:span></ns0:em></ns0:p>
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">依赖：DeepSeek API、Python(scipy)、VitalDB；后续接入 openJiuwen / JiuwenSwarm；</ns0:span></ns0:em></ns0:p>
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">Demo：3 分钟视频，展示多轮思考与工具调用，输出三段式报告。</ns0:span></ns0:em></ns0:p>
        </ns0:content>
