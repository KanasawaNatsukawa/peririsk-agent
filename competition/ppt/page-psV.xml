        <ns0:content verticalAlign="top" paddingTop="3.6" paddingBottom="3.6" paddingLeft="7.2" paddingRight="7.2" fontSize="16" fontFamily="思源黑体" color="rgba(31, 35, 41, 1)" textAlign="left">
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">「大模型决策 + 本地计算」三层架构：</ns0:span></ns0:em></ns0:p>
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">① 应用层：Agent 主循环，自主拆任务、调工具、回填；</ns0:span></ns0:em></ns0:p>
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">② 工具层：病历查询、波形心率检测、ASA 规则引擎；</ns0:span></ns0:em></ns0:p>
          <ns0:p textAlign="left" lineSpacing="multiple:1.4" marginRight="0" defaultTabSize="72"><ns0:em><ns0:span color="rgba(29, 29, 26, 1)" fontSize="15" fontFamily="DengXian" bold="false" strikethrough="false" underline="false">③ 数据模型层：DeepSeek 出报告，VitalDB 供数，本地算数值。</ns0:span></ns0:em></ns0:p>
